@page
@model IndexModel
@{
    ViewData["Title"] = "Room Management";
}

<div class="container mt-4">
    <h1>Room Management System</h1>
    <p class="lead">Search for rooms by their number (e.g., <strong>R10</strong>) or description (e.g., <strong>meeting</strong>, <strong>study</strong>).</p>

    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="search" class="form-control"
                   placeholder="e.g., R10, meeting, study room..."
                   value="@Model.SearchTerm" />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (Model.HasSearched)
    {
        <div class="alert alert-info">
            <h4>Search Results for "@Model.SearchTerm"</h4>
            @if (Model.SearchResults.Any())
            {
                <p>Found @Model.SearchResults.Count match(es):</p>
                <ul class="mb-0">
                    @foreach (var room in Model.SearchResults)
                    {
                        <li><strong>@room.RoomNumber</strong> — @room.Description</li>
                    }
                </ul>
            }
            else
            {
                <p class="mb-0">No rooms found matching "@Model.SearchTerm".</p>
            }
        </div>
    }

    <h2>All Rooms</h2>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th style="width: 20%;">Room Number</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model.Rooms)
            {
                <tr>
                    <td><strong>@room.RoomNumber</strong></td>
                    <td>@room.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>